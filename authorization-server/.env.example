# Configure estas variáveis no Run Configuration do IntelliJ (não commit secrets).
DATASOURCE_URL=jdbc:postgresql://localhost:5432/NOME_DO_BANCO_EXISTENTE
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=<SENHA>
GOOGLE_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_OAUTH_CLIENT_SECRET>
AUTH_SERVER_ISSUER=http://localhost:9000
