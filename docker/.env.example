# Copie para docker/.env. NUNCA inclua docker/.env no Git.
# Use os dados do seu ambiente existente, nao altere os clientes OAuth2 reais.
POSTGRES_PASSWORD=SUBSTITUIR_POR_SENHA_LOCAL_FORTE

# Necessarios para manter o Google Login do Authorization Server.
GOOGLE_CLIENT_ID=SUBSTITUIR_PELO_CLIENT_ID_GOOGLE_EXISTENTE
GOOGLE_CLIENT_SECRET=SUBSTITUIR_PELO_CLIENT_SECRET_GOOGLE_EXISTENTE

# Use exatamente as credenciais do cliente interativo que ja funciona no IntelliJ.
# O registro no banco deve ter redirect_uri http://localhost:8081/login/oauth2/code/biblioteca
BIBLIOTECA_WEB_CLIENT_ID=SUBSTITUIR_PELO_CLIENT_ID_INTERATIVO_EXISTENTE
BIBLIOTECA_WEB_CLIENT_SECRET=SUBSTITUIR_PELO_SEGREDO_INTERATIVO_EXISTENTE
