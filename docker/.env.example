# Copie para docker/.env e altere todas as senhas antes de executar.
# docker/.env e ignorado pelo Git. NAO publique segredos ou este arquivo preenchido.
POSTGRES_PASSWORD=ALTERE_PARA_SENHA_FORTE_POSTGRES_LOCAL

# Usuario criado no primeiro boot: gerente-demo (GERENTE).
# Use senha sua com 12 a 72 bytes em UTF-8, sem #, espacos ou $ para simplificar o .env.
BOOTSTRAP_ADMIN_PASSWORD=ALTERE_PARA_SENHA_FORTE_GERENTE_LOCAL

# Cliente OIDC confidencial criado no primeiro boot (PKCE, redirect localhost:8081).
# ID fixo para demonstracao local; segredo de 16 a 72 bytes em UTF-8.
BIBLIOTECA_WEB_CLIENT_ID=biblioteca-web-local
BIBLIOTECA_WEB_CLIENT_SECRET=ALTERE_PARA_SEGREDO_FORTE_CLIENTE_WEB

# Google e opcional para testar login local. Valores ficticios permitem o startup
# do registro OAuth2, mas o botao Google NAO funcionara sem credenciais reais.
# Para habilitar Google, configure suas credenciais em docker/.env (nao no Git).
GOOGLE_CLIENT_ID=google-login-nao-configurado
GOOGLE_CLIENT_SECRET=google-login-nao-configurado
